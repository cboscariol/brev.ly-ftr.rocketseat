# Porta HTTP da API
PORT=3333
# Ambiente: development | test | production
NODE_ENV=development
# Conexão PostgreSQL (use o host "postgres" quando a API rodar dentro do Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brevly

# URL pública do frontend — usada para montar a URL encurtada (API e CSV)
FRONTEND_URL=http://localhost:5173
# Origens permitidas no CORS, separadas por vírgula (padrão: FRONTEND_URL)
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2 (armazenamento do CSV exportado)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKET=""
# URL pública do bucket (domínio r2.dev ou domínio customizado), sem barra final
CLOUDFLARE_PUBLIC_URL=""
